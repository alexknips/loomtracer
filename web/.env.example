# The HiveMind server this workspace reads. Required. Start one with `hivemind serve` (port 8080 by default).
HIVEMIND_API_URL=http://127.0.0.1:8080

# Bearer token for that server. Read on the server side only: it never reaches a browser.
# Leave empty for a server running without HIVEMIND_API_KEY (development mode, loopback only).
HIVEMIND_API_KEY=

# Optional: the tenant to read, when the token belongs to more than one.
# HIVEMIND_TENANT=

# Optional: the origin this app is served from, for absolute URLs in page metadata.
# APP_URL=http://localhost:3000

# Optional: serve only the landing page and the demo; everything else answers 404.
# NEUROFILAMENT_PUBLIC_ONLY=true
