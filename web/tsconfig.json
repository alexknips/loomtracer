{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@reasoning/*": [
        "../packages/reasoning/src/*"
      ],
      "@/*": [
        "./*"
      ],
      "@reasoning": [
        "../packages/reasoning/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-reasoning-ui/types/**/*.ts",
    ".next-reasoning-ui/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-private-inspect/types/**/*.ts",
    ".next-private-inspect/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
