{
  "env": {
    "LOOMTRACER_DIR": "./loomtracer/",
    "LOOMTRACER_CAPTURE_SCRIPT": ".claude/scripts/capture-decision.sh"
  },
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/capture-decision.sh:*)",
      "Bash(git config user.email)",
      "Bash(git config user.name)",
      "Bash(mkdir -p ./loomtracer)"
    ]
  },
  "extraKnownMarketplaces": {
    "loomtracer": {
      "source": {
        "source": "github",
        "repo": "alexknips/loomtracer"
      }
    }
  },
  "enabledPlugins": {
    "loomtracer-capture@loomtracer": true
  }
}
